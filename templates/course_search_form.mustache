<!-- local_search/course_search_form -->
<form action="{{{coursesearchurl}}}" method="get">
<input type="hidden" name="a" value="1" />
<input type="hidden" name="module" value="course" />
<input type="text" name="mustappear" length="50" value="{{{querystring}}}" />
<input type="hidden" name="canappear" length="50" value="" />
<input type="hidden" name="notappear" length="50" value="" />
&nbsp <input type="submit" value="{{#str}}searchcourses, local_search{{/str}}" />
</form>
<!-- /local_search/course_search_form -->